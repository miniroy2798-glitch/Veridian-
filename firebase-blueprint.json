{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "publicKeyJwk": { "type": "string" }
      },
      "required": ["uid", "displayName", "email", "publicKeyJwk"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A one-on-one chat session between two users.",
      "type": "object",
      "properties": {
        "participants": { 
          "type": "array",
          "description": "Array of 2 user IDs"
        },
        "createdAt": { "type": "string" },
        "lastMessagePreview": { "type": "string" },
        "lastMessageAt": { "type": "string" }
      },
      "required": ["participants", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "An E2EE message within a chat.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "ciphertext": { "type": "string" },
        "iv": { "type": "string" },
        "mediaType": { "type": "string" },
        "createdAt": { "type": "string", "description": "Server timestamp" }
      },
      "required": ["senderId", "ciphertext", "iv", "createdAt"]
    },
    "Call": {
      "title": "Call",
      "description": "WebRTC Signaling Call Object",
      "type": "object",
      "properties": {
        "callerId": { "type": "string" },
        "calleeId": { "type": "string" },
        "offer": { "type": "string" },
        "answer": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["callerId", "calleeId", "createdAt"]
    },
    "IceCandidate": {
      "title": "IceCandidate",
      "description": "WebRTC ICE Candidate",
      "type": "object",
      "properties": {
        "candidate": { "type": "string" }
      },
      "required": ["candidate"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and public keys."
    },
    "chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "1-on-1 chat metadata."
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages within a chat."
    },
    "calls/{callId}": {
      "schema": { "$ref": "#/entities/Call" },
      "description": "WebRTC calls signaling."
    },
    "calls/{callId}/callerCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "ICE candidates from the caller."
    },
    "calls/{callId}/calleeCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "ICE candidates from the callee."
    }
  }
}
